---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import Highlight from '../components/brand/Highlight.astro'
import Sparks from '../components/brand/Sparks.astro'
import Annotation from '../components/brand/Annotation.astro'
import ArrowButton from '../components/brand/ArrowButton.astro'
import StickyCards from '../components/brand/StickyCards.astro'
import Icon from '../components/brand/Icon.astro'
---

<Layout
  title="Contact Dexic — Let's start a conversation."
  description="Whether it's a product question, a partnership, or a problem you think is worth solving — write to us and a real person will reply."
  active="contact"
>
  <section class="page-hero contact-hero has-grid">
    <div class="container">
      <span class="kicker">Contact</span>
      <h1 class="page-title contact-title">
        Let's start a <span class="spark-anchor"
          ><Highlight variant="block" rotate={-1.4} delay={300}>conversation.</Highlight><Sparks
            size={60}
            rotate={-6}
            delay={900}
          /></span
        >
      </h1>

      <div class="contact-grid">
        <div class="contact-intro">
          <p class="body-lg page-copy">
            Whether it's a product question, a partnership, or a problem you think is worth solving — write to us and a
            real person will reply.
          </p>

          <StickyCards
            size="sm"
            class="contact-stickies"
            aria-hidden="true"
            cards={[
              { text: 'A product question?', icon: 'help', tone: 'white' },
              { text: 'A partnership?', icon: 'users', tone: 'lime' },
              { text: 'A problem worth solving?', icon: 'lightbulb', tone: 'violet' }
            ]}
          />

          <div class="info-list">
            <div class="info-row">
              <span class="info-tile" aria-hidden="true"><Icon name="mail" size={18} strokeWidth={2} /></span>
              <span class="label">General</span>
              <a href="mailto:contact@dexic.tech" class="value">contact@dexic.tech</a>
            </div>
            <div class="info-row">
              <span class="info-tile info-tile--violet" aria-hidden="true"
                ><Icon name="users" size={18} strokeWidth={2} /></span
              >
              <span class="label">Founders</span>
              <span class="value">
                <a href="mailto:zubair@dexic.tech">zubair@dexic.tech</a><br />
                <a href="mailto:talha@dexic.tech">talha@dexic.tech</a>
              </span>
            </div>
            <div class="info-row">
              <span class="info-tile info-tile--ink" aria-hidden="true"><Icon name="grid" size={18} strokeWidth={2} /></span>
              <span class="label">Products</span>
              <a href="/#products" class="value">StacShip &middot; TableSnap &middot; Woofy</a>
            </div>
          </div>
        </div>

        <div class="contact-form-col">
          <Annotation text="a real person will reply" arrow="down-left" rotate={-5} delay={700} class="contact-anno" />
          <div class="surface-card contact-card">
            <div class="form-success" data-contact-success hidden>
              <span class="tag">Received</span>
              <p>Thanks for reaching out — we'll reply shortly.</p>
            </div>
            <form class="form-grid" data-contact-form>
              <label class="form-field">
                <span>Name</span>
                <input type="text" name="name" required placeholder="Your name" />
              </label>
              <label class="form-field">
                <span>Email</span>
                <input type="email" name="email" required placeholder="you@company.com" />
              </label>
              <label class="form-field">
                <span>Company <span class="optional">(optional)</span></span>
                <input type="text" name="company" placeholder="Company" />
              </label>
              <label class="form-field">
                <span>Subject</span>
                <input type="text" name="subject" required placeholder="What's this about?" />
              </label>
              <label class="form-field full">
                <span>Message</span>
                <textarea name="message" rows="6" required placeholder="Tell us a little about it."></textarea>
              </label>
              <p class="form-error" data-contact-error hidden>Something went wrong. Please try again.</p>
              <ArrowButton type="submit" label="Submit" class="form-submit" />
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const errorEl = document.querySelector('[data-contact-error]')
    const successEl = document.querySelector('[data-contact-success]')
    errorEl?.setAttribute('hidden', '')
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
    if (submitBtn) {
      submitBtn.disabled = true
      submitBtn.classList.add('is-loading')
    }
    try {
      const formData = new FormData(form)
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(formData)),
        headers: { 'Content-Type': 'application/json' }
      })
      if (!res.ok) throw new Error('Request failed')
      form.hidden = true
      successEl?.removeAttribute('hidden')
    } catch {
      errorEl?.removeAttribute('hidden')
      if (submitBtn) {
        submitBtn.disabled = false
        submitBtn.classList.remove('is-loading')
      }
    }
  })
</script>

<style>
  .contact-hero {
    padding-bottom: clamp(88px, 10vw, 136px);
  }

  .contact-title {
    max-width: 1000px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .page-copy {
    margin-top: 0;
    max-width: 440px;
  }

  .contact-intro :global(.contact-stickies) {
    margin-top: 44px;
    padding-left: 6px;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 40px;
  }

  .info-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 12px 18px 12px 12px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .info-tile {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--lime);
    color: var(--ink);
  }

  .info-tile--violet {
    background: var(--violet);
    color: var(--white);
  }

  .info-tile--ink {
    background: var(--ink);
    color: var(--lime);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .info-row .label {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .info-row .value {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.5;
    text-align: right;
    color: var(--fg);
  }

  .info-row a {
    background-image: linear-gradient(var(--lime), var(--lime));
    background-repeat: no-repeat;
    background-position: 0 90%;
    background-size: 0% 35%;
    transition: background-size 0.35s var(--ease-draw);
  }

  .info-row a:hover {
    background-size: 100% 35%;
  }

  .contact-form-col {
    position: relative;
  }

  .contact-form-col :global(.contact-anno) {
    position: absolute;
    right: 10%;
    top: -86px;
  }

  .contact-card {
    padding: clamp(28px, 3.6vw, 48px);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact-form-col {
      padding-top: 72px;
    }

    .contact-form-col :global(.contact-anno) {
      top: 0;
      right: auto;
      left: 30%;
    }
  }

  @media (max-width: 480px) {
    .info-row {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .info-row .value {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
