---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import HeroOrbit from '../components/HeroOrbit.astro'
import Highlight from '../components/brand/Highlight.astro'
import Scribble from '../components/brand/Scribble.astro'
import Sparks from '../components/brand/Sparks.astro'
import Annotation from '../components/brand/Annotation.astro'
import ArrowButton from '../components/brand/ArrowButton.astro'
import SectionCounter from '../components/brand/SectionCounter.astro'
import PillList from '../components/brand/PillList.astro'
import StickyCards from '../components/brand/StickyCards.astro'
import CornerLabels from '../components/brand/CornerLabels.astro'
import EdgeLabel from '../components/brand/EdgeLabel.astro'
import Watermark from '../components/brand/Watermark.astro'
import ProductStrip from '../components/brand/ProductStrip.astro'
import ProductScreen from '../components/brand/ProductScreen.astro'
import AppTile from '../components/brand/AppTile.astro'
import DashedArrow from '../components/brand/DashedArrow.astro'
import CalloutBand from '../components/brand/CalloutBand.astro'
import { PRODUCTS } from '../data/products'
---

<Layout
  title="Dexic — Building products that remove complexity."
  description="Dexic creates software products that simplify complex workflows — from developer infrastructure to industry-specific platforms — through thoughtful engineering and exceptional user experiences."
  active="home"
>
  <section class="hero">
    <Watermark text="Dexic" class="hero-watermark" />
    <EdgeLabel text="Ideas are common." secondary="Execution is rare." class="hero-edge" />

    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker hero-in" style="--l: 0">A product company</span>
        <h1 class="hero-title">
          <span class="line serif hero-in" style="--l: 1">Building</span>
          <span class="line serif hero-in" style="--l: 2">products <span class="serif-it hero-that">that</span></span>
          <span class="line shout hero-shout hero-in" style="--l: 3"
            ><Highlight variant="block" rotate={-1.6} delay={350}>remove</Highlight></span
          >
          <span class="line shout hero-shout hero-in" style="--l: 4"
            ><span class="spark-anchor"
              ><Highlight variant="block" rotate={0.8} delay={550}>complexity.</Highlight><Sparks
                class="hero-sparks"
                size={60}
                delay={1100}
              /></span
            ></span
          >
        </h1>
        <p class="lead hero-lead hero-in" style="--l: 5">
          <span class="ini">Driving</span>
          <span class="ini">Excellence</span> in <span class="ini">Xperiences</span>, <span class="ini">Innovation</span> and
          <span class="ini">Commitment</span>.
        </p>
        <p class="body-lg hero-sub hero-in" style="--l: 6">
          Dexic creates software products that simplify complex workflows—from developer infrastructure to
          industry-specific platforms—through thoughtful engineering and exceptional user experiences.
        </p>
        <div class="cta-row hero-ctas hero-in" style="--l: 7">
          <ArrowButton href="/#products" label="Explore Products" />
          <a href="/about" class="link-line">About Dexic</a>
        </div>
      </div>
      <HeroOrbit />
    </div>

    <div class="container hero-strip hero-in" style="--l: 8">
      <ProductStrip />
    </div>
  </section>

  <section class="section philosophy has-grid">
    <div class="section-inner philo-grid" data-reveal>
      <div class="philo-copy">
        <SectionCounter num={1} label="Philosophy" />
        <h2 class="h-section serif philo-title">
          Built with <Highlight variant="brush" delay={200}>purpose.</Highlight>
        </h2>
        <p class="philosophy-lead">
          We believe software should <Scribble delay={300}>reduce friction</Scribble>, not create it.
        </p>
        <PillList
          items={[
            'Every product starts by understanding a real problem.',
            'Every feature earns its place.',
            'Every interaction should feel effortless.'
          ]}
        />
      </div>
      <div class="philo-visual" aria-hidden="true">
        <StickyCards
          cards={[
            { text: 'Is it a real problem?', icon: 'target', tone: 'white' },
            { text: 'Does it earn its place?', icon: 'scale', tone: 'lime' },
            { text: 'Does it feel effortless?', icon: 'feather', tone: 'violet' }
          ]}
        />
        <Annotation text="that's the real game." arrow="left" rotate={-5} delay={300} class="philo-anno" />
      </div>
    </div>
    <CornerLabels items={['Ideas', 'Products', 'People', 'Impact']} align="right" class="philo-corner" />
  </section>

  <section id="products" class="section products-section">
    <div class="section-inner">
      <div class="products-head" data-reveal>
        <div>
          <SectionCounter num={2} label="Portfolio" />
          <h2 class="shout products-title">
            Our <span class="spark-anchor"
              ><Highlight variant="block" rotate={-1.4}>Products</Highlight><Sparks
                class="products-sparks"
                size={54}
                rotate={-10}
                delay={500}
              /></span
            >
          </h2>
        </div>
        <div class="products-head-copy">
          <p class="body-lg">Each Dexic product exists because we found a problem worth solving.</p>
          <DashedArrow variant="swoop-down" width={130} class="products-arrow" delay={300} />
        </div>
      </div>

      <div class="products-list">
        {
          PRODUCTS.map((p, i) => (
            <div data-reveal>
              <a href={`/products/${p.slug}`} class:list={['prow', { 'prow--flip': i % 2 === 1 }]}>
                <div class="prow-text">
                  <div class="prow-meta">
                    <SectionCounter num={p.num} total={PRODUCTS.length} />
                    <span class="prow-category">{p.category}</span>
                  </div>
                  <h3 class="prow-title">
                    {p.name}<span class="dot-end" aria-hidden="true" />
                  </h3>
                  <p class="prow-tagline">{p.tagline}</p>
                  <p class="prow-summary">{p.summary}</p>
                  <ArrowButton label="Learn More" static class="prow-cta" />
                </div>
                <div class="prow-visual has-grid" aria-hidden="true">
                  <span class="prow-circle" />
                  <ProductScreen slug={p.slug} class="prow-screen" />
                  <AppTile slug={p.slug} size={68} class="prow-tile" />
                  <Sparks class="prow-sparks" size={48} rotate={i % 2 ? -90 : 0} />
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner cta-inner">
      <CalloutBand lead="We're just getting started." corner={['Build', 'Execute', 'Initiate']}>
        <p>
          Great products aren't built overnight. We're building software that continues to remove complexity across
          industries.
        </p>
        <ArrowButton href="/#products" label="Explore Products" onDark />
      </CalloutBand>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(40px, 5vw, 72px) 0 clamp(56px, 7vw, 96px);
  }

  .hero :global(.hero-watermark) {
    left: 52%;
    top: 1%;
    --wm-font: clamp(220px, 42vw, 680px);
  }

  .hero :global(.hero-edge) {
    position: absolute;
    left: max(14px, calc(50% - var(--content) / 2 - 64px));
    top: 30%;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-title {
    margin: 30px 0 0;
    font-size: clamp(52px, 6.8vw, 110px);
    font-weight: 400;
    line-height: 0.92;
  }

  .hero-title .serif {
    letter-spacing: -0.035em;
  }

  .hero-that {
    margin-left: 0.04em;
    font-size: 0.56em;
    letter-spacing: -0.01em;
  }

  .hero-shout {
    margin-top: 0.08em;
    font-size: 1.04em;
    line-height: 0.96;
  }

  .hero-shout + .hero-shout {
    margin-top: 0.05em;
  }

  .hero-lead {
    max-width: 560px;
    margin-top: 36px;
  }

  .hero-sub {
    max-width: 560px;
    margin-top: 14px;
  }

  .hero-ctas {
    margin-top: 38px;
  }

  .hero-strip {
    position: relative;
    z-index: 2;
    margin-top: clamp(40px, 5vw, 72px);
  }

  /* Soft colour behind the glass so the frosted strip reads as glass */
  .hero-strip::before,
  .hero-strip::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(42px);
    pointer-events: none;
  }

  .hero-strip::before {
    left: 8%;
    top: -10%;
    width: 34%;
    height: 120%;
    background: var(--lime);
    opacity: 0.55;
  }

  .hero-strip::after {
    right: 10%;
    top: 10%;
    width: 26%;
    height: 100%;
    background: var(--violet);
    opacity: 0.3;
  }

  :global(html.motion) .hero-in {
    animation: dexicRise 0.9s var(--ease-out) both;
    animation-delay: calc(var(--l, 0) * 80ms);
  }

  @media (max-width: 1260px) {
    .hero :global(.hero-edge) {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-strip {
      margin-top: 24px;
    }
  }

  /* ---------- Philosophy ---------- */

  .philo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .philo-title {
    font-size: clamp(46px, 6.4vw, 100px);
  }

  .philosophy-lead {
    max-width: 560px;
    margin: 34px 0 44px;
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .philo-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 96px;
  }

  .philo-visual :global(.philo-anno) {
    position: absolute;
    left: -4%;
    bottom: 6px;
  }

  .section :global(.philo-corner) {
    position: absolute;
    right: var(--edge);
    bottom: clamp(32px, 5vw, 56px);
  }

  @media (max-width: 1024px) {
    .philo-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .philo-visual {
      padding-bottom: 72px;
    }

    .section :global(.philo-corner) {
      display: none;
    }
  }

  /* ---------- Products ---------- */

  .products-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px;
    margin-bottom: clamp(56px, 7vw, 104px);
  }

  .products-title {
    margin: 0;
    font-size: clamp(64px, 9.4vw, 148px);
    line-height: 0.9;
  }

  .products-head-copy {
    position: relative;
    max-width: 330px;
    padding-bottom: 14px;
  }

  .products-head :global(.products-arrow) {
    position: absolute;
    right: 34%;
    top: calc(100% + 4px);
  }

  .products-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .prow {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    overflow: hidden;
    border-radius: clamp(24px, 2.6vw, 34px);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--fg);
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.3s ease;
  }

  .prow:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
  }

  .prow--flip .prow-text {
    order: 2;
  }

  .prow-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(32px, 4.6vw, 68px);
  }

  .prow-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
  }

  .prow-category {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .prow-title {
    margin: 30px 0 0;
    font-family: var(--font-serif);
    font-size: clamp(46px, 5.6vw, 84px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .prow-tagline {
    margin: 20px 0 0;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .prow-summary {
    max-width: 500px;
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
    text-wrap: pretty;
  }

  .prow :global(.prow-cta) {
    margin-top: auto;
    padding-top: 40px;
  }

  .prow-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 460px;
    overflow: hidden;
    background: var(--soft);
  }

  .prow-circle {
    position: absolute;
    width: 74%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--soft-2);
    transition: transform 0.8s var(--ease-out);
  }

  .prow:hover .prow-circle {
    transform: scale(1.06);
  }

  .prow-visual :global(.prow-screen) {
    --ps-size: 8.6px;
    transform: translateY(16%) rotate(-7deg);
    transition: transform 0.7s var(--ease-out);
  }

  .prow--flip .prow-visual :global(.prow-screen) {
    transform: translateY(16%) rotate(7deg);
  }

  .prow:hover .prow-visual :global(.prow-screen) {
    transform: translateY(10%) rotate(-3deg);
  }

  .prow--flip:hover .prow-visual :global(.prow-screen) {
    transform: translateY(10%) rotate(3deg);
  }

  .prow-visual :global(.prow-tile) {
    position: absolute;
    top: 13%;
    right: 13%;
    transform: rotate(10deg);
    transition: transform 0.5s var(--ease-spring);
  }

  .prow--flip .prow-visual :global(.prow-tile) {
    right: auto;
    left: 13%;
    transform: rotate(-10deg);
  }

  .prow:hover .prow-visual :global(.prow-tile) {
    transform: rotate(-4deg) scale(1.06);
  }

  .prow-visual :global(.prow-sparks) {
    position: absolute;
    top: 9%;
    left: 16%;
  }

  .prow--flip .prow-visual :global(.prow-sparks) {
    left: auto;
    right: 16%;
  }

  @media (max-width: 900px) {
    .products-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .products-head :global(.products-arrow) {
      display: none;
    }

    .prow {
      grid-template-columns: minmax(0, 1fr);
    }

    .prow--flip .prow-text {
      order: 0;
    }

    .prow-visual {
      order: -1;
      min-height: 320px;
    }

    .prow-visual :global(.prow-screen) {
      --ps-size: 7px;
    }
  }

  /* ---------- CTA ---------- */

  .cta-inner {
    padding-top: clamp(32px, 4vw, 56px);
  }
</style>
