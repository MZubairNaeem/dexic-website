---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import ProductStage from '../../components/ProductStage.astro'
import Highlight from '../../components/brand/Highlight.astro'
import Sparks from '../../components/brand/Sparks.astro'
import Annotation from '../../components/brand/Annotation.astro'
import ArrowButton from '../../components/brand/ArrowButton.astro'
import SectionCounter from '../../components/brand/SectionCounter.astro'
import PillList from '../../components/brand/PillList.astro'
import FeatureCard from '../../components/brand/FeatureCard.astro'
import CalloutBand from '../../components/brand/CalloutBand.astro'
import DashedArrow from '../../components/brand/DashedArrow.astro'
import Watermark from '../../components/brand/Watermark.astro'
import AppTile from '../../components/brand/AppTile.astro'
import Icon from '../../components/brand/Icon.astro'
import { PRODUCTS, getRelatedProducts } from '../../data/products'
import { brandFor, splitHighlight, TONE_CYCLE } from '../../data/brand'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (() => {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } }))
}) satisfies GetStaticPaths

const { product } = Astro.props
const related = getRelatedProducts(product.slug)
const brand = brandFor(product.slug)
const [tagPre, tagMark, tagPost] = splitHighlight(product.tagline, brand.highlight)
const TILT = [-1.2, 0.9, -0.6, 1.1, -0.9, 0.6]
---

<Layout title={`${product.name} — Dexic`} description={product.summary} active="product">
  <section class="phero">
    <Watermark text={product.name} class="phero-watermark" />
    <div class="container">
      <a href="/#products" class="back-link">
        <Icon name="arrow-left" size={14} strokeWidth={2.4} />All products
      </a>
      <div class="phero-grid">
        <div class="phero-copy">
          <div class="phero-meta">
            <SectionCounter num={product.num} total={PRODUCTS.length} />
            <span class="kicker">{product.category}</span>
          </div>
          <h1 class="phero-title serif">
            {product.name}<span class="dot-end" aria-hidden="true"></span>
          </h1>
          <p class="phero-tagline">
            {tagPre}{tagMark && <Highlight variant="marker" delay={450}>{tagMark}</Highlight>}{tagPost}
          </p>
          <p class="body-lg phero-summary">{product.summary}</p>
          <div class="cta-row phero-ctas">
            <ArrowButton href="#demo" label="Request a Demo" />
            <a href={product.url} target="_blank" rel="noopener" class="link-line">
              Visit {product.domain}<Icon name="arrow-up-right" size={14} strokeWidth={2.4} />
            </a>
          </div>
        </div>
        <ProductStage product={product} />
      </div>
    </div>
  </section>

  <section class="section has-grid">
    <div class="section-inner split" data-reveal>
      <div class="problem-head">
        <SectionCounter num={1} label="The Problem" />
        <h2 class="h-sub">{product.problemTitle}</h2>
        <Annotation text="sound familiar?" arrow="right" rotate={-5} delay={400} class="problem-anno" />
      </div>
      <div class="text-col">
        <p class="body-lg">{product.problemA}</p>
        <p class="body-lg">{product.problemB}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner approach-inner">
      <SectionCounter num={2} label="Our Approach" />
      <CalloutBand lead={product.approachTitle}>
        <p>{product.approach}</p>
      </CalloutBand>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <SectionCounter num={3} label="Features" />
        <h2 class="h-section serif">What it <Highlight variant="brush" delay={150}>does.</Highlight></h2>
      </div>
      <ul class="feature-grid" role="list">
        {
          product.features.map((f, i) => (
            <li class="feature-item" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
              <FeatureCard
                heading="h3"
                num={f.num}
                title={f.title}
                text={f.body}
                icon={brand.featureIcons[i]}
                tone={TONE_CYCLE[i % TONE_CYCLE.length]}
                rotate={TILT[i % TILT.length]}
                class="feature-card"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section has-grid">
    <div class="section-inner">
      <div class="section-head" data-reveal>
        <SectionCounter num={4} label="How It Works" />
        <h2 class="h-sub how-title">{product.howTitle}</h2>
      </div>
      <ol class="steps" role="list">
        {
          product.steps.map((s, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${i * 120}ms`}>
              <span class="step-num" aria-hidden="true">
                {s.num}
              </span>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-body">{s.body}</p>
              {i < product.steps.length - 1 && (
                <DashedArrow variant="arc-right" width={110} class="step-arrow" delay={300 + i * 200} />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="section-inner split" data-reveal>
      <div>
        <SectionCounter num={5} label="Benefits" />
        <h2 class="h-section serif">
          Why it <span class="spark-anchor"
            ><Highlight variant="block" rotate={-1.5} delay={150}>matters.</Highlight><Sparks
              size={50}
              delay={700}
            /></span
          >
        </h2>
      </div>
      <PillList items={product.benefits.map((b) => ({ title: b.title, text: b.body }))} />
    </div>
  </section>

  <section class="section">
    <div class="section-inner split" data-reveal>
      <div>
        <SectionCounter num={6} label="FAQ" />
        <h2 class="h-section serif">Questions.</h2>
      </div>
      <div class="faq-list">
        {
          product.faq.map((q) => (
            <div class="faq-item">
              <button type="button" class="faq-question">
                <span>{q.question}</span>
                <span class="faq-sign" aria-hidden="true">
                  +
                </span>
              </button>
              <p class="faq-answer">{q.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="demo" class="section demo-section has-grid">
    <div class="section-inner split demo-split">
      <div class="demo-intro">
        <SectionCounter num={7} label="Request a Demo" />
        <h2 class="h-section serif">See it in <Highlight variant="block" rotate={-1.5}>action.</Highlight></h2>
        <p class="body-lg demo-copy">Schedule a walkthrough to see how this product fits your workflow.</p>
        <Annotation text="pick a day, we'll confirm" arrow="right" rotate={-4} delay={300} class="demo-anno" />
      </div>
      <div class="surface-card demo-card">
        <div class="form-success" data-demo-success hidden>
          <span class="tag">Received</span>
          <p>Thanks — we'll be in touch to confirm a time.</p>
        </div>
        <form class="form-grid" data-demo-form data-product={product.name}>
          <input type="hidden" name="product" value={product.name} />
          <label class="form-field">
            <span>Name</span>
            <input type="text" name="name" required placeholder="Your name" />
          </label>
          <label class="form-field">
            <span>Company</span>
            <input type="text" name="company" placeholder="Company" />
          </label>
          <label class="form-field">
            <span>Email</span>
            <input type="email" name="email" required placeholder="you@company.com" />
          </label>
          <label class="form-field">
            <span>Preferred date</span>
            <input type="date" name="date" />
          </label>
          <label class="form-field full">
            <span>Message</span>
            <textarea name="message" rows="4" placeholder="What would you like to see?"></textarea>
          </label>
          <p class="form-error" data-demo-error hidden>Something went wrong. Please try again.</p>
          <ArrowButton type="submit" label="Request Demo" class="form-submit" />
        </form>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section">
        <div class="section-inner">
          <span class="kicker related-kicker">Related Products</span>
          <div class="related-grid">
            {related.map((r) => (
              <a href={`/products/${r.slug}`} class="related-card">
                <AppTile slug={r.slug} size={58} class="related-tile" />
                <span class="related-cat">{r.category}</span>
                <h3>
                  {r.name}<span class="dot-end" aria-hidden="true" />
                </h3>
                <p>{r.tagline}</p>
                <ArrowButton label="Learn More" size="sm" static class="related-cta" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-demo-form]')
  forms.forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const errorEl = form.parentElement?.querySelector('[data-demo-error]')
      const successEl = form.parentElement?.querySelector('[data-demo-success]')
      errorEl?.setAttribute('hidden', '')
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      if (submitBtn) {
        submitBtn.disabled = true
        submitBtn.classList.add('is-loading')
      }
      try {
        const formData = new FormData(form)
        const res = await fetch('/api/demo', {
          method: 'POST',
          body: JSON.stringify(Object.fromEntries(formData)),
          headers: { 'Content-Type': 'application/json' }
        })
        if (!res.ok) throw new Error('Request failed')
        form.hidden = true
        successEl?.removeAttribute('hidden')
      } catch {
        errorEl?.removeAttribute('hidden')
        if (submitBtn) {
          submitBtn.disabled = false
          submitBtn.classList.remove('is-loading')
        }
      }
    })
  })
</script>

<style>
  /* ---------- Hero ---------- */

  .phero {
    position: relative;
    isolation: isolate;
    padding: clamp(32px, 4vw, 56px) 0 clamp(64px, 8vw, 112px);
  }

  .phero :global(.phero-watermark) {
    right: -4%;
    top: 4%;
    --wm-font: clamp(160px, 26vw, 420px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(32px, 4vw, 52px);
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    background: var(--soft);
    color: var(--fg);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      gap 0.3s var(--ease-out);
  }

  .back-link:hover {
    gap: 14px;
    background: var(--lime);
    color: var(--ink);
  }

  .phero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .phero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 26px;
  }

  .phero-title {
    margin: 30px 0 0;
    font-size: clamp(56px, 8.2vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .phero-tagline {
    max-width: 560px;
    margin: 26px 0 0;
    font-size: clamp(21px, 2vw, 28px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .phero-summary {
    max-width: 540px;
    margin-top: 18px;
  }

  .phero-ctas {
    margin-top: 40px;
  }

  .phero-ctas .link-line :global(svg) {
    margin-left: 2px;
  }

  :global(html.motion) .phero-copy > * {
    animation: dexicRise 0.9s var(--ease-out) both;
  }

  :global(html.motion) .phero-copy > :nth-child(2) {
    animation-delay: 80ms;
  }

  :global(html.motion) .phero-copy > :nth-child(3) {
    animation-delay: 160ms;
  }

  :global(html.motion) .phero-copy > :nth-child(4) {
    animation-delay: 240ms;
  }

  :global(html.motion) .phero-copy > :nth-child(5) {
    animation-delay: 320ms;
  }

  @media (max-width: 1024px) {
    .phero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Problem ---------- */

  .problem-head {
    position: relative;
  }

  .problem-head :global(.problem-anno) {
    margin-top: 36px;
  }

  /* Stacked layout: the paragraphs sit below, so the arrow points down */
  @media (max-width: 900px) {
    .problem-head :global(.problem-anno .anno-arrow) {
      width: 64px;
      transform: translate(-6px, 16px) rotate(80deg);
    }
  }

  .text-col {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 600px;
    padding-top: 8px;
  }

  /* ---------- Approach ---------- */

  .approach-inner {
    padding-top: 0;
  }

  /* ---------- Features ---------- */

  .section-head {
    margin-bottom: clamp(44px, 5vw, 72px);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-item {
    display: flex;
  }

  .feature-item :global(.feature-card) {
    flex: 1;
  }

  @media (max-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Steps ---------- */

  .how-title {
    max-width: 720px;
    font-size: clamp(36px, 4.4vw, 64px);
    font-weight: 900;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    font-family: var(--font-shout);
    font-size: 32px;
    letter-spacing: 0.02em;
    transition: transform 0.5s var(--ease-spring);
  }

  .step:hover .step-num {
    transform: rotate(-12deg) scale(1.06);
  }

  .step:nth-child(2) .step-num {
    background: var(--violet);
    color: var(--white);
  }

  .step:nth-child(3) .step-num {
    background: var(--fg);
    color: var(--bg);
  }

  .step-title {
    margin: 28px 0 10px;
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.2vw, 30px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .step-body {
    max-width: 340px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .step :global(.step-arrow) {
    position: absolute;
    left: calc(76px + 18px);
    top: 8px;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .step :global(.step-arrow) {
      display: none;
    }
  }

  /* ---------- Demo ---------- */

  .demo-split {
    align-items: center;
  }

  .demo-copy {
    max-width: 420px;
    margin-top: 26px;
  }

  .demo-intro :global(.demo-anno) {
    margin-top: 40px;
  }

  .demo-card {
    padding: clamp(28px, 3.4vw, 44px);
  }

  @media (max-width: 900px) {
    .demo-intro :global(.demo-anno) {
      display: none;
    }
  }

  /* ---------- Related ---------- */

  .related-kicker {
    margin-bottom: 36px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(28px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--fg);
    transition:
      transform 0.45s var(--ease-spring),
      box-shadow 0.3s ease;
  }

  .related-card:nth-child(odd) {
    transform: rotate(-0.8deg);
  }

  .related-card:nth-child(even) {
    transform: rotate(0.8deg);
  }

  .related-card:hover {
    transform: translateY(-6px) rotate(0deg);
    box-shadow: var(--shadow-lift);
  }

  .related-card:hover :global(.related-tile) {
    animation: dexicWobble 0.7s ease;
  }

  .related-cat {
    margin-top: 26px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .related-card h3 {
    margin: 10px 0 8px;
    font-family: var(--font-serif);
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .related-card p {
    margin: 0;
    font-size: 16px;
    color: var(--muted);
  }

  .related-card :global(.related-cta) {
    margin-top: 28px;
  }

  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
