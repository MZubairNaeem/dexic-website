---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Cursor from '../components/brand/Cursor.astro'
import '../styles/global.css'
import '../styles/site.css'

interface Props {
  title: string
  description: string
  active?: 'home' | 'product' | 'about' | 'contact' | 'legal'
}

const { title, description, active = 'legal' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f6f6f2" id="theme-color-meta" />
    <link rel="icon" href="/D.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/D.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Kalam:wght@400;700&family=Manrope:wght@400..800&family=Playfair+Display:ital,wght@0,700..900;1,700..900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      ;(() => {
        const root = document.documentElement
        // The site opens in light mode by default. Only an explicit saved
        // choice of 'dark' or 'system' (follow the OS) overrides that.
        let choice = 'light'
        try {
          const stored = localStorage.getItem('dexic-theme')
          if (stored === 'dark' || stored === 'system') choice = stored
        } catch {
          // Storage blocked: default to light.
        }
        if (choice === 'system') delete root.dataset.theme
        else root.dataset.theme = choice

        const meta = document.getElementById('theme-color-meta')
        if (meta) {
          const isDark = choice === 'dark' || (choice === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
          meta.setAttribute('content', isDark ? '#0e0e0e' : '#f6f6f2')
        }

        // Motion is opt-in: scroll reveals only hide content once we know JS
        // and IntersectionObserver are available. Fallback un-hides everything.
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion')
          setTimeout(() => {
            if (!root.dataset.motionReady) root.classList.remove('motion')
          }, 4000)
        }
      })()
    </script>
  </head>
  <body>
    <div id="top"></div>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    <Cursor />
    <script>
      function initProgressBar() {
        const bar = document.getElementById('dexic-progress')
        if (!bar) return
        const update = () => {
          const doc = document.documentElement
          const scrollable = doc.scrollHeight - doc.clientHeight
          const progress = scrollable > 0 ? window.scrollY / scrollable : 0
          bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`
        }
        update()
        window.addEventListener('scroll', update, { passive: true })
        window.addEventListener('resize', update)
      }

      // Fade-up reveals ([data-reveal]) and draw-in marks ([data-draw]):
      // highlighters, scribbles, arrows and sparks animate when scrolled into view.
      function initScrollMotion() {
        const root = document.documentElement
        if (!root.classList.contains('motion')) return
        root.dataset.motionReady = '1'

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              const el = entry.target
              if (el.hasAttribute('data-reveal')) el.classList.add('is-visible')
              if (el.hasAttribute('data-draw')) el.classList.add('is-drawn')
              io.unobserve(el)
            }
          },
          { rootMargin: '0px 0px -12% 0px' }
        )
        document.querySelectorAll('[data-reveal], [data-draw]').forEach((el) => io.observe(el))
      }

      // Hero visuals drift gently with the pointer (fine pointers only).
      function initParallax() {
        const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'))
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        if (!stages.length || !fine || reduced) return

        const visible = new Set<HTMLElement>()
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement
            if (entry.isIntersecting) visible.add(el)
            else visible.delete(el)
          }
        })
        stages.forEach((el) => io.observe(el))

        let frame = 0
        let mx = 0
        let my = 0
        window.addEventListener(
          'pointermove',
          (e) => {
            mx = (e.clientX / window.innerWidth - 0.5) * 2
            my = (e.clientY / window.innerHeight - 0.5) * 2
            if (frame || !visible.size) return
            frame = requestAnimationFrame(() => {
              frame = 0
              visible.forEach((el) => {
                el.style.setProperty('--mx', mx.toFixed(3))
                el.style.setProperty('--my', my.toFixed(3))
              })
            })
          },
          { passive: true }
        )
      }

      function initFaq() {
        const items = Array.from(document.querySelectorAll('.faq-item'))
        for (const item of items) {
          const btn = item.querySelector('.faq-question')
          const sign = item.querySelector('.faq-sign')
          btn?.setAttribute('aria-expanded', 'false')
          btn?.addEventListener('click', () => {
            const isOpen = item.classList.toggle('is-open')
            btn.setAttribute('aria-expanded', String(isOpen))
            if (sign) sign.textContent = isOpen ? '−' : '+'
          })
        }
      }

      // Landing on a page with a URL fragment (e.g. /#products from another
      // page) should jump straight to that section. Chrome's own "scroll to
      // fragment on load" can silently fail here: our web fonts are still
      // downloading when it fires, and once they swap in and reflow the page
      // above the target, the browser never retries — it's left at the top.
      // We do it ourselves, and keep re-asserting the position for a few
      // seconds until it actually holds (a single correction can itself get
      // undone by a later reflow).
      function initHashScroll() {
        if (!location.hash) return
        let target: Element | null
        try {
          target = document.querySelector(location.hash)
        } catch {
          return
        }
        if (!target) return
        const el = target

        const offset = () => parseFloat(getComputedStyle(el).scrollMarginTop) || 0
        const settled = () => Math.abs(el.getBoundingClientRect().top - offset()) < 4

        let attempts = 0
        const tick = () => {
          if (settled() || attempts >= 40) return
          el.scrollIntoView({ behavior: 'auto', block: 'start' })
          attempts += 1
          setTimeout(tick, 150)
        }
        tick()
      }

      initProgressBar()
      initScrollMotion()
      initParallax()
      initFaq()
      initHashScroll()
    </script>
  </body>
</html>
