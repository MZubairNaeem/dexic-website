---
import Wordmark from './brand/Wordmark.astro'
import Icon from './brand/Icon.astro'

interface Props {
  active?: 'home' | 'product' | 'about' | 'contact' | 'legal'
}

const { active = 'home' } = Astro.props
const productsActive = active === 'home' || active === 'product'
const aboutActive = active === 'about'
const contactActive = active === 'contact'
---

<header class="site-header">
  <div class="bar container">
    <Wordmark href="/" size="sm" class="header-mark" />
    <nav class="nav" aria-label="Primary">
      <a href="/#products" class="nav-link" class:list={{ 'is-active': productsActive }}>Products</a>
      <span class="nav-sep" aria-hidden="true"></span>
      <a href="/about" class="nav-link" class:list={{ 'is-active': aboutActive }} aria-current={aboutActive ? 'page' : undefined}
        >About</a
      >
      <a
        href="/contact"
        class="nav-contact"
        class:list={{ 'is-active': contactActive }}
        aria-current={contactActive ? 'page' : undefined}
      >
        <span class="nav-contact-dot" aria-hidden="true"><Icon name="arrow-right" size={14} strokeWidth={2.4} /></span>
        <span>Contact</span>
      </a>
    </nav>
  </div>
  <div class="progress-track">
    <div id="dexic-progress" class="progress-bar"></div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 80px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    position: relative;
    isolation: isolate;
    padding: 6px 2px;
    color: var(--fg);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 3px -7px 3px -5px;
    z-index: -1;
    background: var(--lime);
    transform: scaleX(0) rotate(-2deg);
    transform-origin: 0 50%;
    transition: transform 0.45s var(--ease-draw);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--ink);
  }

  .nav-link:hover::before,
  .nav-link.is-active::before {
    transform: scaleX(1) rotate(-2deg);
  }

  .nav-sep {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
  }

  .nav-contact {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-left: 8px;
    padding: 5px 18px 5px 5px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition: transform 0.35s var(--ease-spring);
  }

  .nav-contact:hover {
    transform: translateY(-2px) rotate(-1.5deg);
  }

  .nav-contact-dot {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    transition: transform 0.4s var(--ease-spring);
  }

  .nav-contact:hover .nav-contact-dot,
  .nav-contact.is-active .nav-contact-dot {
    transform: rotate(-45deg);
  }

  .progress-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
  }

  .progress-bar {
    height: 2px;
    background: var(--lime);
    transform: scaleX(0);
    transform-origin: 0 50%;
    will-change: transform;
  }

  @media (max-width: 720px) {
    .bar {
      height: 66px;
    }

    .bar :global(.header-mark .wm-tag) {
      display: none;
    }

    .nav {
      gap: 16px;
    }

    .nav-link {
      font-size: 10.5px;
      letter-spacing: 0.16em;
    }

    .nav-sep {
      display: none;
    }

    .nav-contact {
      margin-left: 0;
      padding: 4px 14px 4px 4px;
      gap: 8px;
      font-size: 10.5px;
      letter-spacing: 0.16em;
    }

    .nav-contact-dot {
      width: 28px;
      height: 28px;
    }
  }

  @media (max-width: 400px) {
    .nav {
      gap: 12px;
    }

    .nav-link,
    .nav-contact {
      letter-spacing: 0.1em;
    }

    .nav-contact {
      padding: 9px 13px;
    }

    .nav-contact-dot {
      display: none;
    }
  }
</style>
