---
// Frosted glass bar listing products with app-icon tiles, plus "More ahead".
import AppTile from './AppTile.astro'
import Icon from './Icon.astro'
import { PRODUCTS } from '../../data/products'

interface Props {
  label?: string
  class?: string
}

const { label = "Products we're building", class: className, ...rest } = Astro.props
---

<nav class:list={['pstrip', className]} aria-label="Our products" {...rest}>
  <div class="pstrip-head">
    <span class="pstrip-label">{label}</span>
    <a href="/#products" class="pstrip-more">More ahead <Icon name="chevron-right" size={14} strokeWidth={2.4} /></a>
  </div>
  <ul class="pstrip-list" role="list">
    {
      PRODUCTS.map((p) => (
        <li>
          <a href={`/products/${p.slug}`} class="pstrip-item">
            <AppTile slug={p.slug} size={56} class="pstrip-tile" />
            <span class="pstrip-text">
              <span class="pstrip-name">{p.name}</span>
              <span class="pstrip-desc">{p.tagline}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .pstrip {
    position: relative;
    padding: 22px 30px 26px;
    border: 1px solid var(--glass-border);
    border-radius: 26px;
    background: var(--glass);
    box-shadow:
      0 0 0 1px var(--line),
      0 24px 60px rgba(0, 0, 0, 0.08);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
  }

  .pstrip-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .pstrip-label {
    color: var(--muted);
  }

  .pstrip-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg);
    white-space: nowrap;
    transition: gap 0.3s var(--ease-out);
  }

  .pstrip-more:hover {
    gap: 10px;
  }

  .pstrip-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pstrip-list li + li {
    border-left: 1px solid var(--line);
  }

  .pstrip-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 4px 24px;
    border-radius: 16px;
  }

  .pstrip-list li:first-child .pstrip-item {
    padding-left: 0;
  }

  .pstrip-item:hover :global(.pstrip-tile) {
    animation: dexicWobble 0.7s ease;
  }

  .pstrip-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .pstrip-name {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--fg);
  }

  .pstrip-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .pstrip {
      padding: 20px 20px 10px;
    }

    .pstrip-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .pstrip-list li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .pstrip-item,
    .pstrip-list li:first-child .pstrip-item {
      padding: 14px 0;
    }
  }
</style>
