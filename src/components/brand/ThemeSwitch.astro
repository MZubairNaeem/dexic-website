---
// Light / Auto / Dark segmented switch. Light is the default; the saved
// choice (if any) is applied before first paint by Layout.astro's inline
// script, which this component's own script stays in sync with.
import Icon from './Icon.astro'
import type { IconName } from './icons'

const OPTIONS: { value: string; label: string; icon: IconName }[] = [
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'system', label: 'Auto', icon: 'monitor' },
  { value: 'dark', label: 'Dark', icon: 'moon' }
]
---

<div class="theme-switch" role="group" aria-label="Colour theme">
  {
    OPTIONS.map((o) => (
      <button type="button" class="theme-btn" data-theme-choice={o.value} aria-pressed={o.value === 'light' ? 'true' : 'false'}>
        <Icon name={o.icon} size={14} strokeWidth={2} />
        <span>{o.label}</span>
      </button>
    ))
  }
</div>

<script>
  const KEY = 'dexic-theme'

  // Mirrors the default in Layout.astro's inline script: light unless the
  // visitor explicitly saved 'dark' or 'system' (follow the OS).
  function saved(): string {
    try {
      const stored = localStorage.getItem(KEY)
      return stored === 'dark' || stored === 'system' ? stored : 'light'
    } catch {
      return 'light'
    }
  }

  function sync(choice: string) {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeChoice === choice))
    })
  }

  function syncThemeColor(choice: string) {
    const meta = document.getElementById('theme-color-meta')
    if (!meta) return
    const isDark = choice === 'dark' || (choice === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
    meta.setAttribute('content', isDark ? '#0e0e0e' : '#f6f6f2')
  }

  function apply(choice: string) {
    const root = document.documentElement
    if (choice === 'system') delete root.dataset.theme
    else root.dataset.theme = choice
    try {
      localStorage.setItem(KEY, choice)
    } catch {
      // Storage unavailable (private mode) — the choice still applies for this page.
    }
    sync(choice)
    syncThemeColor(choice)
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((btn) => {
    btn.addEventListener('click', () => apply(btn.dataset.themeChoice ?? 'light'))
  })
  sync(saved())
</script>

<style>
  .theme-switch {
    display: inline-flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: var(--soft);
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .theme-btn:hover {
    color: var(--fg);
  }

  .theme-btn[aria-pressed='true'] {
    background: var(--lime);
    color: var(--ink);
  }
</style>
