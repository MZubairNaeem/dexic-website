---
// Black rounded block: centred title with a lime lead phrase and a lime squiggle.
import Sparks from './Sparks.astro'
import CornerLabels from './CornerLabels.astro'

interface Props {
  lead: string
  text?: string
  heading?: 'h2' | 'p'
  corner?: string[]
  class?: string
}

const { lead, text, heading: Heading = 'h2', corner, class: className, ...rest } = Astro.props
---

<div class:list={['band', className]} data-reveal {...rest}>
  <Sparks class="band-sparks" size={58} rotate={-90} delay={500} />
  {corner && <CornerLabels items={corner} class="band-corner" />}
  <Heading class="band-title"
    ><span class="band-lead">{lead}</span>{
      text && (
        <>
          {' '}
          {text}
        </>
      )
    }</Heading
  >
  <svg class="band-squiggle" viewBox="0 0 160 18" aria-hidden="true" focusable="false" data-draw>
    <path d="M4 11c10-8 20-8 30 0s20 8 30 0 20-8 30 0 20 8 30 0 20-8 30 0" pathLength="1"></path>
  </svg>
  <div class="band-body">
    <slot />
  </div>
</div>

<style>
  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(60px, 8vw, 104px) clamp(24px, 6vw, 88px);
    border-radius: clamp(26px, 3vw, 40px);
    background: var(--band);
    color: var(--paper);
    text-align: center;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, #000 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, #000 20%, transparent 80%);
  }

  .band :global(.band-sparks) {
    position: absolute;
    top: clamp(22px, 3vw, 40px);
    right: clamp(22px, 4vw, 56px);
  }

  .band :global(.band-corner) {
    position: absolute;
    left: clamp(22px, 3.4vw, 48px);
    bottom: clamp(22px, 3vw, 40px);
    color: var(--paper);
    text-align: left;
  }

  .band-title {
    max-width: 920px;
    margin: 0 auto;
    font-family: var(--font-serif);
    font-size: clamp(38px, 5.6vw, 84px);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .band-lead {
    color: var(--lime);
  }

  .band-squiggle {
    display: block;
    width: 150px;
    height: 18px;
    margin: 28px auto 0;
    overflow: visible;
  }

  .band-squiggle path {
    fill: none;
    stroke: var(--lime);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 0;
  }

  :global(html.motion) .band-squiggle:not(.is-drawn) path {
    stroke-dashoffset: 1;
  }

  :global(html.motion) .band-squiggle.is-drawn path {
    transition: stroke-dashoffset 1.1s var(--ease-draw) 0.3s;
  }

  .band-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    margin-top: 30px;
  }

  .band-body :global(p) {
    max-width: 560px;
    margin: 0;
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.65;
    color: rgba(246, 246, 242, 0.74);
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .band :global(.band-corner) {
      display: none;
    }
  }
</style>
