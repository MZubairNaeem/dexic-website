---
// Numbered pill rows: lime circle with "01" overlapping a light rounded pill.
interface Item {
  title: string
  text?: string
}

interface Props {
  items: (string | Item)[]
  start?: number
  columns?: 1 | 2
  class?: string
}

const { items, start = 1, columns = 1, class: className, ...rest } = Astro.props
const rows = items.map((item, i) => ({
  ...(typeof item === 'string' ? { title: item } : item),
  num: String(start + i).padStart(2, '0')
}))
---

<ol class:list={['pills', `pills--cols-${columns}`, className]} role="list" {...rest}>
  {
    rows.map((row, i) => (
      <li class:list={['pill', { 'pill--rich': row.text }]} style={`--i:${i}`}>
        <span class="pill-num" aria-hidden="true">
          {row.num}
        </span>
        <span class="pill-body">
          <span class="pill-title">{row.title}</span>
          {row.text && <span class="pill-text">{row.text}</span>}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .pills {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pills--cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 20px;
  }

  @media (max-width: 720px) {
    .pills--cols-2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pill {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 54px;
  }

  .pill-num {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin-top: -25px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 5px var(--bg);
    transition: transform 0.45s var(--ease-spring);
  }

  .pill--rich .pill-num {
    top: 18px;
    margin-top: 0;
  }

  .pill-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-left: 26px;
    padding: 15px 26px 15px 42px;
    border-radius: 999px;
    background: var(--soft);
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.25s ease;
  }

  .pill--rich .pill-body {
    padding: 18px 26px 20px 42px;
    border-radius: 24px;
  }

  .pill-title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--fg);
  }

  .pill--rich .pill-title {
    font-weight: 800;
  }

  .pill-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .pill:hover .pill-num {
    transform: rotate(-14deg) scale(1.08);
  }

  .pill:hover .pill-body {
    transform: translateX(6px);
  }
</style>
