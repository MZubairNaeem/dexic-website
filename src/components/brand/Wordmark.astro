---
// Dexic Core logo — geometric D with a lime core, plus an optional tracked
// tagline that starts with a short lime line. Letters follow the text colour.
import { LOGO } from './logo'

interface Props {
  href?: string
  size?: 'sm' | 'md' | 'lg'
  tagline?: string | false
  class?: string
}

const { href, size = 'md', tagline = 'Build • Execute • Initiate', class: className, ...rest } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag
  href={href}
  class:list={['wordmark', `wordmark--${size}`, className]}
  aria-label={href ? 'Dexic home' : undefined}
  {...rest}
>
  <svg
    class="wm-logo"
    viewBox={`0 0 ${LOGO.width} 100`}
    fill="currentColor"
    role={href ? undefined : 'img'}
    aria-label={href ? undefined : 'Dexic'}
    aria-hidden={href ? 'true' : undefined}
    focusable="false"
  >
    <path d={LOGO.d}></path>
    <circle class="wm-core" cx={LOGO.core.cx} cy={LOGO.core.cy} r={LOGO.core.r}></circle>
    <path d={LOGO.e} fill-rule="evenodd"></path>
    <path d={LOGO.xic}></path>
  </svg>
  {
    tagline && (
      <span class="wm-tag" aria-hidden="true">
        <span class="wm-line" />
        {tagline}
      </span>
    )
  }
</Tag>

<style>
  .wordmark {
    /* Logo height (= cap height of the D) */
    --wm-h: 28px;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--wm-h) * 0.34);
    color: var(--fg);
    line-height: 1;
  }

  .wordmark--sm {
    --wm-h: 24px;
  }

  .wordmark--lg {
    --wm-h: clamp(40px, 5vw, 60px);
  }

  .wm-logo {
    display: block;
    flex: none;
    height: var(--wm-h);
    width: auto;
    overflow: visible;
  }

  .wm-core {
    fill: var(--lime);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.4s var(--ease-spring);
  }

  a.wordmark:hover .wm-core {
    transform: translateX(4px) scale(0.86);
  }

  .wm-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: max(9px, calc(var(--wm-h) * 0.2));
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wm-line {
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--lime);
  }

  .wordmark--sm .wm-tag {
    font-size: 8.5px;
    letter-spacing: 0.28em;
  }
</style>
